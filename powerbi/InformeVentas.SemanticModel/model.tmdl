model InformeVentas
	culture: es-CO
	defaultMode: import

	table factura
		lineageTag: 11111111-1111-1111-1111-111111111111

		column factura_pk
			dataType: int64
			sourceColumn: factura_pk
			summarizeBy: none
			isAvailableInMdx: true

		column numero_orden
			dataType: int64
			sourceColumn: numero_orden
			summarizeBy: none

		column numero_linea
			dataType: int64
			sourceColumn: numero_linea
			summarizeBy: none

		column proveedor_fk
			dataType: int64
			sourceColumn: proveedor_fk
			summarizeBy: none

		column fecha_venta
			dataType: int64
			sourceColumn: fecha_venta
			summarizeBy: none

		column cliente_fk
			dataType: int64
			sourceColumn: cliente_fk
			summarizeBy: none

		column producto_fk
			dataType: int64
			sourceColumn: producto_fk
			summarizeBy: none

		column cantidad_de_producto
			dataType: int64
			sourceColumn: cantidad_de_producto
			summarizeBy: sum

		column precio_bruto
			dataType: decimal
			sourceColumn: precio_bruto
			summarizeBy: sum

		column porcentaje_descuento
			dataType: decimal
			sourceColumn: porcentaje_descuento
			summarizeBy: average

		column porcentaje_impuesto
			dataType: decimal
			sourceColumn: porcentaje_impuesto
			summarizeBy: average

		column venta_neta
			dataType: decimal
			sourceColumn: venta_neta
			summarizeBy: sum

		column monto_impuesto
			dataType: decimal
			sourceColumn: monto_impuesto
			summarizeBy: sum

		column dwh_created_date
			dataType: dateTime
			sourceColumn: dwh_created_date
			summarizeBy: none

		measure 'Venta Neta' = SUM ( factura[venta_neta] )
			formatString: #,0.00

		measure 'Venta Bruta' = SUM ( factura[precio_bruto] )
			formatString: #,0.00

		measure 'Monto Impuesto' = SUM ( factura[monto_impuesto] )
			formatString: #,0.00

		measure 'Monto Descuento' = SUMX ( factura, factura[precio_bruto] * factura[porcentaje_descuento] )
			formatString: #,0.00

		measure 'Unidades Vendidas' = SUM ( factura[cantidad_de_producto] )
			formatString: #,0

		measure 'Nro Lineas' = COUNTROWS ( factura )
			formatString: #,0

		measure 'Nro Ordenes' = DISTINCTCOUNT ( factura[numero_orden] )
			formatString: #,0

		measure 'Ticket Medio' = DIVIDE ( [Venta Neta], [Nro Lineas] )
			formatString: #,0.00

		measure 'Pct Descuento Efectivo' = DIVIDE ( [Monto Descuento], [Venta Bruta] )
			formatString: 0.00%

		measure 'Venta Neta YTD' = TOTALYTD ( [Venta Neta], dim_tiempo[fecha_completa] )
			formatString: #,0.00

		measure 'Venta Neta Año Anterior' = CALCULATE ( [Venta Neta], SAMEPERIODLASTYEAR ( dim_tiempo[fecha_completa] ) )
			formatString: #,0.00

		measure 'Var Neta YoY' = [Venta Neta] - [Venta Neta Año Anterior]
			formatString: #,0.00

		measure 'Var Neta YoY %' = DIVIDE ( [Var Neta YoY], [Venta Neta Año Anterior] )
			formatString: 0.00%

		partition factura = m
			mode: import
			source =
				let
					Source = Parquet.Document(File.Contents("C:\Users\andre\Documents\github\sql-datawarehouse-project\data\parquet\factura.parquet"))
				in
					Source

	table dim_tiempo
		lineageTag: 22222222-2222-2222-2222-222222222222

		column tiempo_pk
			dataType: int64
			sourceColumn: tiempo_pk
			summarizeBy: none
			isAvailableInMdx: true

		column anio
			dataType: int64
			sourceColumn: anio
			summarizeBy: none

		column mes
			dataType: int64
			sourceColumn: mes
			summarizeBy: none

		column dia
			dataType: int64
			sourceColumn: dia
			summarizeBy: none

		column fecha_completa
			dataType: date
			sourceColumn: fecha_completa
			summarizeBy: none

		column mes_nombre
			dataType: string
			sourceColumn: mes_nombre
			sort by column: mes

		column dia_semana
			dataType: string
			sourceColumn: dia_semana

		column trimestre
			dataType: int64
			sourceColumn: trimestre
			summarizeBy: none

		column trimestre_nombre
			dataType: string
			sourceColumn: trimestre_nombre
			sort by column: trimestre

		column dwh_created_date
			dataType: dateTime
			sourceColumn: dwh_created_date
			summarizeBy: none

		partition dim_tiempo = m
			mode: import
			source =
				let
					Source = Parquet.Document(File.Contents("C:\Users\andre\Documents\github\sql-datawarehouse-project\data\parquet\dim_tiempo.parquet"))
				in
					Source

	table dim_cliente
		lineageTag: 33333333-3333-3333-3333-333333333333

		column cliente_pk
			dataType: int64
			sourceColumn: cliente_pk
			summarizeBy: none
			isAvailableInMdx: true

		column nombre_cliente
			dataType: string
			sourceColumn: nombre_cliente

		column segmento_mercado
			dataType: string
			sourceColumn: segmento_mercado

		column pais_nombre
			dataType: string
			sourceColumn: pais_nombre

		column regio_nombre
			dataType: string
			sourceColumn: regio_nombre

		column dwh_created_date
			dataType: dateTime
			sourceColumn: dwh_created_date
			summarizeBy: none

		measure 'Venta Top 10 Clientes' = CALCULATE ( [Venta Neta], TOPN ( 10, VALUES ( dim_cliente[nombre_cliente] ), [Venta Neta] ) )
			formatString: #,0.00

		measure 'Pct Concentracion Top 10' = DIVIDE ( [Venta Top 10 Clientes], [Venta Neta] )
			formatString: 0.00%

		partition dim_cliente = m
			mode: import
			source =
				let
					Source = Parquet.Document(File.Contents("C:\Users\andre\Documents\github\sql-datawarehouse-project\data\parquet\dim_cliente.parquet"))
				in
					Source

