			formatString: #,0.00

		measure 'Pct Lineas Retrasadas' = DIVIDE ( [Lineas Retrasadas], [Nro Lineas] )
			formatString: 0.00%

		measure 'Dias Retraso Promedio' = AVERAGE ( vw_rfv04_ventas_retrasadas[dias_de_retraso] )
			formatString: #,0.0

