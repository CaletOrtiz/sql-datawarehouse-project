	relationship RelFechaVenta
		fromColumn: factura[fecha_venta]
		toColumn: dim_tiempo[tiempo_pk]

	relationship RelCliente
		fromColumn: factura[cliente_fk]
		toColumn: dim_cliente[cliente_pk]

	relationship RelProducto
		fromColumn: factura[producto_fk]
		toColumn: dim_producto[producto_pk]
