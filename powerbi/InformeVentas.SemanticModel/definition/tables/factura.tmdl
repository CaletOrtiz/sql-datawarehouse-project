table factura
	lineageTag: 11111111-1111-1111-1111-111111111111

	measure 'Venta Neta' = SUM ( factura[venta_neta] )
		formatString: #,0.00
		lineageTag: cce14770-29fd-4421-8716-9920084a7c35

	measure 'Venta Bruta' = SUM ( factura[precio_bruto] )
		formatString: #,0.00
		lineageTag: d8596d89-c812-424b-9f1e-f7653c7cca0f

	measure 'Monto Impuesto' = SUM ( factura[monto_impuesto] )
		formatString: #,0.00
		lineageTag: 234e5f79-d28d-4945-82f0-eb8d6c4e1b2f

	measure 'Monto Descuento' = SUMX ( factura, factura[precio_bruto] * factura[porcentaje_descuento] )
		formatString: #,0.00
		lineageTag: 30926c3c-4845-4b1e-9496-9cfa96d38991

	measure 'Unidades Vendidas' = SUM ( factura[cantidad_de_producto] )
		formatString: #,0
		lineageTag: 71361c27-00ad-4bb1-9fa8-fd94d1d02040

	measure 'Nro Lineas' = COUNTROWS ( factura )
		formatString: #,0
		lineageTag: 41e1b9f8-bc00-4646-9275-b98233979adc

	measure 'Nro Ordenes' = DISTINCTCOUNT ( factura[numero_orden] )
		formatString: #,0
		lineageTag: 47584eb2-e949-4cfa-8405-a48ceeba660f

	measure 'Ticket Medio' = DIVIDE ( [Venta Neta], [Nro Lineas] )
		formatString: #,0.00
		lineageTag: 7cc08951-9194-4b7d-bc88-690967cc2d0d

	measure 'Pct Descuento Efectivo' = DIVIDE ( [Monto Descuento], [Venta Bruta] )
		formatString: 0.00%
		lineageTag: c8c420a6-1580-419b-93d7-06031d263657

	measure 'Venta Neta YTD' = TOTALYTD ( [Venta Neta], dim_tiempo[fecha_completa] )
		formatString: #,0.00
		lineageTag: b027306a-6bb0-40aa-899c-a43e66ba4a7d

	measure 'Venta Neta Año Anterior' = CALCULATE ( [Venta Neta], SAMEPERIODLASTYEAR ( dim_tiempo[fecha_completa] ) )
		formatString: #,0.00
		lineageTag: 2dc0d8b3-d516-461d-a184-bf36d8b45f48

	measure 'Var Neta YoY' = [Venta Neta] - [Venta Neta Año Anterior]
		formatString: #,0.00
		lineageTag: aabcad83-0868-4208-a7ca-e8c8407f6bee

	measure 'Var Neta YoY %' = DIVIDE ( [Var Neta YoY], [Venta Neta Año Anterior] )
		formatString: 0.00%
		lineageTag: 066f0c58-edcc-44d2-bfda-893ce958be77

