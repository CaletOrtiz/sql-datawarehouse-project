	column dwh_created_date
		dataType: dateTime
		lineageTag: 98654c5f-215c-43e6-b150-782453aef86a
		summarizeBy: none
		sourceColumn: dwh_created_date

		variation Variación
			isDefault
			relationship: a19e39c1-5548-4551-881e-016ae8544c8a
			defaultHierarchy: LocalDateTable_96f30b33-4b50-4c07-99ea-65f92e424980.'Jerarquía de fechas'

	measure 'Venta Acumulada' = CALCULATE([Venta Neta], FILTER(ALL(dim_tiempo), dim_tiempo[fecha_completa] <= MAX(dim_tiempo[fecha_completa])))
		formatString: #,0.00

	measure 'Ticket Medio por Orden' = DIVIDE([Venta Neta], DISTINCTCOUNT(factura[numero_orden]))
		formatString: #,0.00

	measure 'Pct del Total del Periodo' = DIVIDE([Venta Neta], CALCULATE([Venta Neta], ALL(dim_tiempo)))
		formatString: 0.00%

	measure 'Venta Año Base 1992' = CALCULATE([Venta Neta], dim_tiempo[anio] = 1992)
		formatString: #,0.00

	measure 'Crecimiento vs 1992 %' = DIVIDE([Venta Neta] - [Venta Año Base 1992], [Venta Año Base 1992])
		formatString: 0.00%

	measure 'Unidades por Orden' = DIVIDE([Unidades Vendidas], DISTINCTCOUNT(factura[numero_orden]))
		formatString: #,0.0

	partition factura = m
		mode: import
		source =
				let
					Source = Parquet.Document(File.Contents("C:\Users\andre\Documents\github\sql-datawarehouse-project\data\parquet\factura.parquet"))
				in
					Source

